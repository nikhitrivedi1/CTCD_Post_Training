# Environment variables for Forge
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# === Required for W&B experiment tracking ===
# Get your key from: https://wandb.ai/authorize
WANDB_API_KEY=

# W&B project name (default: Forge-Default)
# Set this to organize runs into a specific project
WANDB_PROJECT=Forge-Default

# Optional: Disable W&B entirely
# WANDB_MODE=disabled

# === Required for Llama models ===
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# === Optional: GitHub access for private repos ===
# Only needed if cloning private repositories
GITHUB_TOKEN=